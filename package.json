{
  "name": "wurxmediahub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-contrast.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify:browser": "node scripts/verify-page.mjs",
    "verify:rls": "node scripts/check-rls.mjs",
    "verify:session": "node scripts/check-session.mjs",
    "verify:apply": "node scripts/check-apply.mjs",
    "verify:review": "node scripts/check-review.mjs",
    "verify:brands": "node scripts/check-brands.mjs",
    "verify:offer-requests": "node scripts/check-offer-requests.mjs",
    "verify:responsive": "node scripts/check-responsive.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:creator": "node scripts/shots-creator.mjs",
    "verify:live": "node scripts/check-live.mjs",
    "verify:content": "node scripts/check-content.mjs",
    "verify:contests": "node scripts/check-contests.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
