# ============================================================================
# WurxMediaHub, environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for the DEV Supabase
# project. `.env.local` is gitignored; this file is not, so never put a real
# key in here.
#
# RULE: only values that are safe to ship inside the public browser bundle may
# be prefixed with VITE_. Anything else, service-role keys, webhook secrets,
# API tokens, belongs in Supabase Edge Function secrets, never here.
# ============================================================================

# Supabase project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable key, the "sb_publishable_..." one, NOT the legacy
# "eyJ..." anon JWT. Safe to expose: it grants nothing on its own, because every
# table is protected by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=
